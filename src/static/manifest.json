{
  "manifest_version": 3,
  "name": "HiredSignal — Apply with the right CV",
  "description": "Auto-fills job applications with the tailored CV HiredSignal generated for that specific job.",
  "version": "0.1.0",
  "action": {
    "default_icon": "logo.png",
    "default_title": "HiredSignal — Apply with the right CV",
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "js": [
        "contentScript.js"
      ],
      "matches": [
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.ashbyhq.com/*",
        "https://jobs.smartrecruiters.com/*",
        "https://*.smartrecruiters.com/*",
        "https://apply.workable.com/*",
        "https://jobs.workable.com/*",
        "https://*.icims.com/*"
      ],
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],
      "matches": [
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.ashbyhq.com/*",
        "https://jobs.smartrecruiters.com/*",
        "https://*.smartrecruiters.com/*",
        "https://apply.workable.com/*",
        "https://jobs.workable.com/*",
        "https://*.icims.com/*"
      ]
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://hiredsignal.com/*",
    "https://*.hiredsignal.com/*",
    "https://*/*"
  ]
}
